{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "JwtSetting": {
    "IssuerSigningKey": "",
    "ValidIssuer": "book-inventory",
    "ValidAudience": "book-inventory-api"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Notification": {
    "WorkerIntervalSeconds": 30,
    "BatchSize": 50,
    "RetryMinutes": [ 5, 15, 30, 60, 360 ],
    "DefaultMaxRetry": 5,
    "StuckAfterMinutes": 10
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "FromEmail": "",
    "DisplayName": "Book Inventory",
    "TimeoutSeconds": 30,
    "LogBody": false
  },
  "MasterLayout": {
    "CompanyName": "Book Inventory"
  },
  "Auth": {
    "Password": {
      "MinimumLength": 8,
      "RequiredUpperCase": 1,
      "RequiredLowerCase": 1,
      "RequiredDigit": 1,
      "SystemAccountMinimumLength": 0
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "Tokens": {
      "AccessTokenMinutes": 15,
      "RefreshTokenHours": 12,
      "RememberMeDays": 30,
      "RefreshCookieName": "book_inventory_refresh",
      "RefreshCookiePath": "/api/v1/auth",
      "AccessCookieName": "book_inventory_access",
      "AccessCookiePath": "/api",
      "RefreshCookieHours": 12,
      "SystemAccountSessionMinutes": 60
    },
    "RateLimit": {
      "LoginPermitPerMinute": 10,
      "ForgotPasswordPermitPerMinute": 5
    },
    "Reset": {
      "TokenMinutes": 30,
      "MaxRequestsPerHour": 5
    }
  },
  "Registration": {
    "Mode": "ApprovalRequired"
  },
  "SystemAccount": {
    "Enabled": true,
    "UserName": "system",
    "AllowedIps": [],
    "AlertEmail": "",
    "AllowFinancialActions": true
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
