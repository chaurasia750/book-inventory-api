{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=book_inventory;Username=postgres"
  },
  "JwtSetting": {
    // Keep this empty: the dev signing key lives in user-secrets (dotnet user-secrets set "JwtSetting:IssuerSigningKey" "<random >= 32 chars>")
    "IssuerSigningKey": "",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Email": {
    "LogBody": true
  },
  "Auth": {
    "Reset": {
      "LinkUrl": "http://localhost:4200/auth/reset-password"
    }
  },
  "Notification": {
    "WorkerIntervalSeconds": 5
  },
  "Seed": {
    "SuperAdmin": {
      "UserName": "superadmin",
      "Email": "admin@book-inventory.local",
      "FullName": "Local Super Admin"
    }
  }
}
