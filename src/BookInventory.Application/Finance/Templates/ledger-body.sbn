<!doctype html>
<html><head><meta charset="utf-8">
<style>
  /* Spec finance R18: the A4 ledger statement: company header, title, party, filter in words, the table (header repeats on every page), totals. */
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; font-size: 9px; line-height: 1.3; color: #141414; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-variant-numeric: tabular-nums; }
  .head { display: flex; gap: 8px; align-items: flex-start; border-bottom: 1.2px solid #1f1f1f; padding-bottom: 5px; }
  .head img { width: 46px; height: 46px; object-fit: contain; }
  .head .co { flex: 1; } .head .name { font-size: 15px; font-weight: 700; line-height: 1.1; }
  .title { text-align: center; margin: 8px 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .14em; }
  .caps { text-transform: uppercase; letter-spacing: .06em; font-size: 7.5px; color: #4a4a4a; font-weight: 600; }
  .party { border: 1px solid #1f1f1f; padding: 4px 7px; margin-bottom: 6px; display: flex; justify-content: space-between; gap: 10px; }
  .party .who { font-size: 11px; font-weight: 700; } .party p { margin: 0; } .muted { color: #4a4a4a; }
  table { width: 100%; border-collapse: collapse; }
  thead { display: table-header-group; } tr { break-inside: avoid; }
  th { background: #f1efe9; border-top: 1px solid #1f1f1f; border-bottom: 1px solid #1f1f1f; padding: 3px 4px; text-align: left; font-size: 7.5px; text-transform: uppercase; letter-spacing: .05em; }
  td { padding: 2.5px 4px; border-bottom: 1px solid #d3d0c7; vertical-align: top; } .r { text-align: right; white-space: nowrap; }
  tr.open td { background: #faf9f5; font-style: italic; }
  tr.total td { background: #f1efe9; font-weight: 700; border-top: 1px solid #1f1f1f; border-bottom: 1px solid #1f1f1f; }
</style></head>
<body>
<div class="head">
  {{ if company.logo }}<img src="{{ company.logo }}" alt="">{{ end }}
  <div class="co">
    <div class="name">{{ company.name }}</div>
    {{ if company.address }}<div>{{ company.address }}</div>{{ end }}
    {{ if company.contact }}<div>{{ company.contact }}</div>{{ end }}
    {{ if company.gstin }}<div>GSTIN <b>{{ company.gstin }}</b></div>{{ end }}
  </div>
</div>
<div class="title">LEDGER STATEMENT</div>
<div class="party">
  <div>
    <span class="caps">{{ if party.kind == "VENDOR" }}Vendor{{ else }}School{{ end }}</span>
    <p class="who">{{ party.name }}</p>
    <p class="muted">{{ party.code }}{{ if party.address }} · {{ party.address }}{{ end }}</p>
    <p class="muted">{{ if party.state }}{{ party.state }}{{ end }}{{ if party.gstin }}{{ if party.state }} · {{ end }}GSTIN {{ party.gstin }}{{ end }}</p>
  </div>
  <div style="text-align:right;"><span class="caps">Period</span><p><b>{{ filter }}</b></p></div>
</div>
<table>
  <thead><tr><th style="width:62px">Date</th><th style="width:105px">Document</th><th>Detail</th><th class="r" style="width:70px">Debit</th><th class="r" style="width:70px">Credit</th><th class="r" style="width:78px">Balance</th></tr></thead>
  <tbody>
    <tr class="open"><td></td><td>Opening balance</td><td></td><td class="r"></td><td class="r"></td><td class="r">{{ opening }}</td></tr>
  {{ for r in rows }}
    <tr><td>{{ r.date }}</td><td>{{ r.document }}</td><td>{{ r.detail }}</td><td class="r">{{ r.debit }}</td><td class="r">{{ r.credit }}</td><td class="r">{{ r.balance }}</td></tr>
  {{ end }}
    <tr class="total"><td></td><td>Total</td><td></td><td class="r">{{ total_debit }}</td><td class="r">{{ total_credit }}</td><td class="r">{{ closing }}</td></tr>
  </tbody>
</table>
</body></html>
