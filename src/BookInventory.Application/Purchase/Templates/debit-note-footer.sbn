<div style="width:100%;box-sizing:border-box;padding:0 0.3in;font-family:'Segoe UI',Arial,sans-serif;font-size:7.5px;color:#4a4a4a;-webkit-print-color-adjust:exact;">
  <div style="display:flex;justify-content:space-between;border-top:1px solid #c9c6bd;padding-top:3px;">
    <span>{{ note.number }} · {{ vendor.name }}</span>
    <span>Page <span class="pageNumber"></span> of <span class="totalPages"></span></span>
  </div>
</div>
