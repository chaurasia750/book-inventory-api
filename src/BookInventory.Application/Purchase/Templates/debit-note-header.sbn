<div style="width:100%;box-sizing:border-box;padding:0 0.3in;font-family:'Segoe UI',Arial,sans-serif;font-size:8px;line-height:1.25;color:#141414;-webkit-print-color-adjust:exact;">
  <div style="display:flex;gap:8px;align-items:flex-start;border-bottom:1.2px solid #1f1f1f;padding-bottom:4px;">
    {{ if company.logo }}<img src="{{ company.logo }}" style="width:46px;height:46px;object-fit:contain;" alt="">{{ end }}
    <div style="flex:1;">
      <div style="font-size:14px;font-weight:700;line-height:1.1;">{{ company.name }}</div>
      {{ if company.tagline }}<div style="color:#4a4a4a;">{{ company.tagline }}</div>{{ end }}
      {{ if company.address }}<div>{{ company.address }}</div>{{ end }}
      {{ if company.contact }}<div>{{ company.contact }}</div>{{ end }}
      <div>{{ if company.gstin }}GSTIN <b>{{ company.gstin }}</b>{{ end }}{{ if company.gstin && company.pan }} · {{ end }}{{ if company.pan }}PAN <b>{{ company.pan }}</b>{{ end }}</div>
    </div>
    <div style="text-align:right;white-space:nowrap;">
      <div style="font-size:12px;font-weight:700;letter-spacing:.1em;">DEBIT NOTE</div>
      <div>Debit note no. <b>{{ note.number }}</b></div>
      <div>Date <b>{{ note.date }}</b></div>
      <div>Financial year {{ note.year }}</div>
    </div>
  </div>
</div>
