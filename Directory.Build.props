<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- NuGet package metadata shared by every building block -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<Version>1.0.0</Version>
		<Authors>BookInventory</Authors>
		<Company>BookInventory</Company>
		<Copyright>Copyright (c) BookInventory</Copyright>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- CS1591: missing XML comment on public member. Docs are added where they carry information. -->
		<NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
		<PackageReadmeFile Condition="Exists('$(MSBuildThisFileDirectory)README.md')">README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
